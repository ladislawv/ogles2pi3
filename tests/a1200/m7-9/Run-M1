; Run-M1 - ogles2 M7 run 9: the disk cache's size. See ReadMe.txt.
;   CD to this directory, then:   Execute Run-M1
; Nothing is installed: libs/ is added to LIBS: for the run and removed at the
; end; OGLES2Cache: points at a drawer of this run's. Output goes to results/.
.bra {
.ket }

FailAt 21
If NOT EXISTS libs/ogles2.library
  Echo "Please CD into the ogles2-m7-9 directory first,"
  Echo "then run:  Execute Run-M1"
  Quit 20
EndIf

Assign M7R9: ""
If NOT EXISTS M7R9:results
  MakeDir M7R9:results
EndIf
Echo "ogles2 M7 run 9" >>M7R9:results/00-progress.txt
Date >>M7R9:results/00-progress.txt
Assign LIBS: M7R9:libs ADD
SetEnv OGLES2/LogFile M7R9:results/ogles2.log

; Each step on a library freshly loaded (the trim runs once a load) and an empty drawer.
Echo "Step 1 of 3: over the limit: the oldest go."
Delete M7R9:cache ALL QUIET FORCE >NIL:
MakeDir M7R9:cache
Assign OGLES2Cache: M7R9:cache
SetEnv OGLES2/CacheKB 64
Avail FLUSH >NIL:
M7R9:bin/m7_cache TRIM >M7R9:results/1-trim.txt
List M7R9:cache >M7R9:results/1-cache.txt

Echo "Step 2 of 3: the limit off: all stay."
Delete M7R9:cache/#? ALL QUIET FORCE >NIL:
SetEnv OGLES2/CacheKB 0
Avail FLUSH >NIL:
M7R9:bin/m7_cache NOLIMIT >M7R9:results/2-nolimit.txt

Echo "Step 3 of 3: under the limit: all stay."
Delete M7R9:cache/#? ALL QUIET FORCE >NIL:
SetEnv OGLES2/CacheKB 64
Avail FLUSH >NIL:
M7R9:bin/m7_cache UNDER >M7R9:results/3-under.txt

UnSetEnv OGLES2/CacheKB
UnSetEnv OGLES2/LogFile
Assign OGLES2Cache:
Assign LIBS: M7R9:libs REMOVE
Avail FLUSH >NIL:
Delete M7R9:cache ALL QUIET FORCE >NIL:
If NOT EXISTS M7R9:results/notes.txt
  Copy M7R9:notes-template.txt M7R9:results/notes.txt
EndIf
List M7R9:results >M7R9:results/99-files.txt
Echo "finished" >>M7R9:results/00-progress.txt
Date >>M7R9:results/00-progress.txt
Assign M7R9:
Echo ""
Echo "Done. Results are in results/."

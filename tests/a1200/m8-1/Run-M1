; Run-M1 - ogles2 M8 run 1: queued framebuffer-object jobs. See ReadMe.txt.
;   CD to this directory, then:   Execute Run-M1
; Nothing is installed: libs/ is added to LIBS: for the run and removed at the
; end. Output goes to results/.
.key FROM/K
.def FROM 1
.bra {
.ket }

FailAt 21
If NOT EXISTS libs/ogles2.library
  Echo "Please CD into the ogles2-m8-1 directory first,"
  Echo "then run:  Execute Run-M1"
  Quit 20
EndIf

Assign M8R1: ""
If NOT EXISTS M8R1:results
  MakeDir M8R1:results
EndIf
Echo "ogles2 M8 run 1, starting at step {FROM}" >>M8R1:results/00-progress.txt
Date >>M8R1:results/00-progress.txt
Assign LIBS: M8R1:libs ADD
Avail FLUSH >NIL:
CD M8R1:bin

If NOT {FROM} GT 1 VAL
  Echo "Step 1 of 2: queued (colours changing, about a second)"
  SetEnv OGLES2/LogFile M8R1:results/ogles2-1.log
  M8R1:bin/m8_queue >M8R1:results/1-queue.txt
  Echo "step 1 done" >>M8R1:results/00-progress.txt
EndIf

If NOT {FROM} GT 2 VAL
  Echo "Step 2 of 2: the control, not queued (the same)"
  SetEnv OGLES2/LogFile M8R1:results/ogles2-2.log
  SetEnv OGLES2/NoQueue 1
  M8R1:bin/m8_queue >M8R1:results/2-noqueue.txt
  UnSetEnv OGLES2/NoQueue
  Echo "step 2 done" >>M8R1:results/00-progress.txt
EndIf

UnSetEnv OGLES2/LogFile
CD M8R1:
Assign LIBS: M8R1:libs REMOVE
Avail FLUSH >NIL:
If NOT EXISTS M8R1:results/notes.txt
  Copy M8R1:notes-template.txt M8R1:results/notes.txt
EndIf
List M8R1:results >M8R1:results/99-files.txt
Echo "finished" >>M8R1:results/00-progress.txt
Date >>M8R1:results/00-progress.txt
Assign M8R1:
Echo ""
Echo "Done. Results are in results/."

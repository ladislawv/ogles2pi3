 <Text>glClearColor(0.0103834, 0.570254, 0.356395, 0.60894);</Text>
 <Text>glClear(GL_COLOR_BUFFER_BIT);</Text>
 <Text>glBindFramebuffer(GL_FRAMEBUFFER, 2);</Text>
 <Text>glViewport(48, 48, 16, 16);</Text>
 <Text>glGetAttribLocation(1, a_position);</Text>
 <Text>// 0 returned</Text>

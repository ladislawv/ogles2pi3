 <Text>// 1 returned</Text>
 <Text>glUseProgram(1);</Text>
 <Text>glEnableVertexAttribArray(0);</Text>
 <Text>glVertexAttribPointer(0, 4, GL_FLOAT, GL_FALSE, 0, 0xa70ddb0);</Text>
 <Text>glEnableVertexAttribArray(1);</Text>
 <Text>glVertexAttribPointer(1, 2, GL_FLOAT, GL_FALSE, 0, 0xa70dd90);</Text>
 <Text>glDrawElements(GL_TRIANGLES, 6, GL_UNSIGNED_SHORT, 0xa70dd84);</Text>
 <Text>glDisableVertexAttribArray(0);</Text>
 <Text>glDisableVertexAttribArray(1);</Text>
 <Text>glReadPixels(0, 0, 64, 64, GL_RGBA, GL_UNSIGNED_BYTE, 0xa71ad9c)</Text>
 <Text>glGetError();</Text>

 <Text>glGetError();</Text>
 <Text>// GL_NO_ERROR returned</Text>
 <Text>glHint(GL_GENERATE_MIPMAP_HINT, GL_DONT_CARE);</Text>
 <Text>glGetBooleanv(GL_GENERATE_MIPMAP_HINT, 0x0a6f1e2f);</Text>
 <Text>// data = { GL_TRUE }</Text>

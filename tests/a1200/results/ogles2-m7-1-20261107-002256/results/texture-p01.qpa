#beginTestCaseResult dEQP-GLES2.functional.texture.specification.basic_teximage2d.a8_2d
<?xml version="1.0" encoding="UTF-8"?>
<TestCaseResult CasePath="dEQP-GLES2.functional.texture.specification.basic_teximage2d.a8_2d" Version="0.3.4" CaseType="SelfValidate">
 <Text>glClearColor(0.125, 0.25, 0.5, 1);</Text>
 <Text>glClear(GL_DEPTH_BUFFER_BIT|GL_STENCIL_BUFFER_BIT|GL_COLOR_BUFFER_BIT);</Text>
 <Text>glGenTextures(1, 0x0a44bef0);</Text>
 <Text>// textures = { 1 }</Text>
 <Text>glBindTexture(GL_TEXTURE_2D, 1);</Text>
 <Text>glPixelStorei(GL_UNPACK_ALIGNMENT, 1);</Text>
 <Text>glTexImage2D(GL_TEXTURE_2D, 0, GL_ALPHA, 64, 128, 0, GL_ALPHA, GL_UNSIGNED_BYTE, 0xb07b94c);</Text>
 <Text>glTexImage2D(GL_TEXTURE_2D, 1, GL_ALPHA, 32, 64, 0, GL_ALPHA, GL_UNSIGNED_BYTE, 0xb07d95c);</Text>
 <Text>glTexImage2D(GL_TEXTURE_2D, 2, GL_ALPHA, 16, 32, 0, GL_ALPHA, GL_UNSIGNED_BYTE, 0xb07b94c);</Text>
 <Text>glTexImage2D(GL_TEXTURE_2D, 3, GL_ALPHA, 8, 16, 0, GL_ALPHA, GL_UNSIGNED_BYTE, 0xb07bb5c);</Text>
 <Text>glTexImage2D(GL_TEXTURE_2D, 4, GL_ALPHA, 4, 8, 0, GL_ALPHA, GL_UNSIGNED_BYTE, 0xb07b94c);</Text>
 <Text>glTexImage2D(GL_TEXTURE_2D, 5, GL_ALPHA, 2, 4, 0, GL_ALPHA, GL_UNSIGNED_BYTE, 0xb07b97c);</Text>
 <Text>glTexImage2D(GL_TEXTURE_2D, 6, GL_ALPHA, 1, 2, 0, GL_ALPHA, GL_UNSIGNED_BYTE, 0xb07b94c);</Text>
 <Text>glTexImage2D(GL_TEXTURE_2D, 7, GL_ALPHA, 1, 1, 0, GL_ALPHA, GL_UNSIGNED_BYTE, 0xb07b95c);</Text>
 <Text>glGetError();</Text>
 <Text>// GL_NO_ERROR returned</Text>
 <Text>glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_NEAREST_MIPMAP_NEAREST);</Text>
 <Text>glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_NEAREST);</Text>

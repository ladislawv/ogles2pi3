#beginTestCaseResult dEQP-GLES2.functional.fbo.api.valid_tex2d_attachments
<?xml version="1.0" encoding="UTF-8"?>
<TestCaseResult CasePath="dEQP-GLES2.functional.fbo.api.valid_tex2d_attachments" Version="0.3.4" CaseType="SelfValidate">
 <Text>glBindFramebuffer(GL_FRAMEBUFFER, 1);</Text>
 <Text>glBindTexture(GL_TEXTURE_2D, 1);</Text>
 <Text>glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, 1, 0);</Text>
 <Text>glGetError();</Text>
 <Text>// GL_NO_ERROR returned</Text>
 <Text>// Pass, expected GL_NO_ERROR</Text>
 <Text>glFramebufferTexture2D(GL_FRAMEBUFFER, GL_DEPTH_ATTACHMENT, GL_TEXTURE_2D, 1, 0);</Text>
 <Text>glGetError();</Text>
 <Text>// GL_NO_ERROR returned</Text>
 <Text>// Pass, expected GL_NO_ERROR</Text>
 <Text>glFramebufferTexture2D(GL_FRAMEBUFFER, GL_STENCIL_ATTACHMENT, GL_TEXTURE_2D, 1, 0);</Text>
 <Text>glGetError();</Text>
 <Text>// GL_NO_ERROR returned</Text>
 <Text>// Pass, expected GL_NO_ERROR</Text>
 <Number Name="TestDuration" Description="Test case duration in microseconds" Tag="Time" Unit="us">11834</Number>
 <Result StatusCode="Pass">Pass</Result>
</TestCaseResult>

#endTestCaseResult


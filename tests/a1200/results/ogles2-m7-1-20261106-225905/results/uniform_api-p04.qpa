  <Text>// Got u_var0[0] value 0</Text>
  <Text>glGetUniformLocation(1, u_var0[1]);</Text>
  <Text>// -1 returned</Text>
  <Text>glGetUniformLocation(1, u_var1);</Text>
  <Text>// 1 returned</Text>
  <Text>glGetUniformfv(1, 1, 0x0a44f0fe);</Text>
  <Text>glGetError();</Text>
  <Text>// GL_NO_ERROR returned</Text>
  <Text>// Got u_var1 value (false, false, false, false)</Text>
  <Text>glGetUniformLocation(1, u_var2);</Text>
  <Text>// -1 returned</Text>
</Section>
 <Section Name="UniformAssign" Description="Uniform value assignments">
  <Text>glGetUniformLocation(1, u_var0[0]);</Text>
  <Text>// 0 returned</Text>
  <Text>// Texture for the sampler uniform u_var0[0] will be filled with color (0.34, 0.48, 0.77, 0.97)</Text>
  <Text>// Texture for the sampler uniform u_var0[1] will be filled with color (0.34, 0.48, 0.77, 0.97)</Text>
  <Text>glUniform1iv(0, 2, { 0, 1 });</Text>
  <Text>glGetError();</Text>
  <Text>// GL_NO_ERROR returned</Text>
  <Text>// Uniform u_var0[1] is covered by another glUniform*v() call to the same array</Text>
  <Text>glGetUniformLocation(1, u_var1);</Text>
  <Text>// 1 returned</Text>
  <Text>// Using type float to set boolean value (true, true, false, true) for u_var1</Text>
  <Text>glUniform4f(1, 3.99907, -1.58366, 0, -6.30324);</Text>
  <Text>glGetError();</Text>
  <Text>// GL_NO_ERROR returned</Text>
  <Text>glGetUniformLocation(1, u_var2);</Text>
  <Text>// -1 returned</Text>
  <Text>glUniform4i(-1, -8, -9, 5, 8);</Text>
  <Text>glGetError();</Text>
  <Text>// GL_NO_ERROR returned</Text>
</Section>
 <Number Name="TestDuration" Description="Test case duration in microseconds" Tag="Time" Unit="us">103572</Number>
 <Result StatusCode="Pass">Passed</Result>
</TestCaseResult>

#endTestCaseResult


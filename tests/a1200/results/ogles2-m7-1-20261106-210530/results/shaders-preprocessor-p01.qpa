#beginTestCaseResult dEQP-GLES2.functional.shaders.preprocessor.invalid_conditionals.nested_elif_without_if_vertex
<?xml version="1.0" encoding="UTF-8"?>
<TestCaseResult CasePath="dEQP-GLES2.functional.shaders.preprocessor.invalid_conditionals.nested_elif_without_if_vertex" Version="0.3.4" CaseType="SelfValidate">
 <Text>Expecting shader compilation to fail.</Text>
 <ShaderProgram LinkStatus="Fail">
  <InfoLog></InfoLog>
  <VertexShader CompileStatus="Fail">
   <ShaderSource>precision mediump float;
void main()
{
#if 1
gl_Position = vec4(1.0);
#    elif
gl_Position = vec4(0.0);
#    endif
#endif
}
</ShaderSource>
   <InfoLog>0:6(1): preprocessor warning: ignoring illegal #elif without expression
0:9(1): preprocessor error: #endif without #if

</InfoLog>
</VertexShader>
  <FragmentShader CompileStatus="OK">
   <ShaderSource></ShaderSource>
   <InfoLog></InfoLog>
</FragmentShader>
</ShaderProgram>
 <Number Name="VertexCompileTime" Description="Vertex shader compile time" Tag="Time" Unit="ms">160.880997</Number>
 <Number Name="FragmentCompileTime" Description="Fragment shader compile time" Tag="Time" Unit="ms">39.118999</Number>
 <Number Name="TestDuration" Description="Test case duration in microseconds" Tag="Time" Unit="us">226560</Number>
 <Result StatusCode="Pass">Pass</Result>
</TestCaseResult>

#endTestCaseResult


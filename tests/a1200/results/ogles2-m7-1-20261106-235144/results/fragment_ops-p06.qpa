#beginTestCaseResult dEQP-GLES2.functional.fragment_ops.random.0
<?xml version="1.0" encoding="UTF-8"?>
<TestCaseResult CasePath="dEQP-GLES2.functional.fragment_ops.random.0" Version="0.3.4" CaseType="SelfValidate">
 <Section Name="Iteration0" Description="Iteration 0">
  <Text>glClearColor(0.25, 0.5, 0.75, 1);</Text>
  <Text>glClearDepthf(1);</Text>
  <Text>glClearStencil(0);</Text>
  <Text>glClear(GL_DEPTH_BUFFER_BIT|GL_STENCIL_BUFFER_BIT|GL_COLOR_BUFFER_BIT);</Text>
  <Text>glViewport(170, 121, 64, 64);</Text>
  <Text>glDisable(GL_SCISSOR_TEST);</Text>
  <Text>glDisable(GL_STENCIL_TEST);</Text>
  <Text>glEnable(GL_DEPTH_TEST);</Text>
  <Text>glDepthFunc(GL_NEVER);</Text>
  <Text>glDepthMask(GL_FALSE);</Text>
  <Text>glDisable(GL_BLEND);</Text>
  <Text>glDisable(GL_DITHER);</Text>
  <Text>glColorMask(GL_FALSE, GL_TRUE, GL_TRUE, GL_TRUE);</Text>
  <Text>// Quad: (11, 60) -&gt; (49, 2), color: [(1, 0.4, 0, 0), (0.2, 0.5, 0, 0.5), (0.6, 0.2, 0.5, 0.5), (1, 0, 0.8, 0.6)], depth: [0.8, 0.8, 0.8, 0.8]</Text>
  <Text>glDisable(GL_SCISSOR_TEST);</Text>
  <Text>glDisable(GL_STENCIL_TEST);</Text>
  <Text>glEnable(GL_DEPTH_TEST);</Text>
  <Text>glDepthFunc(GL_NOTEQUAL);</Text>
  <Text>glDepthMask(GL_TRUE);</Text>
  <Text>glDisable(GL_BLEND);</Text>
  <Text>glDisable(GL_DITHER);</Text>
  <Text>glColorMask(GL_TRUE, GL_FALSE, GL_FALSE, GL_FALSE);</Text>
  <Text>// Quad: (0, 54) -&gt; (63, 10), color: [(0.4, 0.4, 1, 0.6), (0.5, 0.2, 0.2, 1), (0.5, 0, 0.5, 0.8), (0, 0.4, 1, 1)], depth: [0.8, 0.8, 0.8, 0.8]</Text>
  <Text>glDisable(GL_SCISSOR_TEST);</Text>
  <Text>glDisable(GL_STENCIL_TEST);</Text>
  <Text>glEnable(GL_DEPTH_TEST);</Text>
  <Text>glDepthFunc(GL_NOTEQUAL);</Text>
  <Text>glDepthMask(GL_TRUE);</Text>
  <Text>glDisable(GL_BLEND);</Text>
  <Text>glEnable(GL_DITHER);</Text>
  <Text>glColorMask(GL_TRUE, GL_TRUE, GL_FALSE, GL_TRUE);</Text>
  <Text>// Quad: (2, 10) -&gt; (46, 49), color: [(0.6, 0.2, 0.4, 1), (0.2, 0, 0.4, 0.2), (0, 1, 0.5, 0.4), (0.2, 0.2, 0.4, 1)], depth: [0.8, 0.8, 0.8, 0.8]</Text>
  <Text>glGetError();</Text>
  <Text>// GL_NO_ERROR returned</Text>
  <ImageSet Name="CompareResult" Description="Image Comparison Result" />
  <Text>  Passed.</Text>
</Section>
 <Section Name="Iteration1" Description="Iteration 1">
  <Text>glClearColor(0.25, 0.5, 0.75, 1);</Text>
  <Text>glClearDepthf(1);</Text>
  <Text>glClearStencil(0);</Text>
  <Text>glClear(GL_DEPTH_BUFFER_BIT|GL_STENCIL_BUFFER_BIT|GL_COLOR_BUFFER_BIT);</Text>
  <Text>glViewport(92, 82, 64, 64);</Text>
  <Text>glDisable(GL_SCISSOR_TEST);</Text>
  <Text>glEnable(GL_STENCIL_TEST);</Text>
  <Text>glStencilFuncSeparate(GL_FRONT, GL_GEQUAL, 19, 3476666076);</Text>
  <Text>glStencilOpSeparate(GL_FRONT, GL_REPLACE, GL_KEEP, GL_DECR_WRAP);</Text>

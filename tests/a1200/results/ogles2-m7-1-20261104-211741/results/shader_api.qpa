#beginTestCaseResult dEQP-GLES2.functional.shader_api.create_delete.delete_vertex_fragment
<?xml version="1.0" encoding="UTF-8"?>
<TestCaseResult CasePath="dEQP-GLES2.functional.shader_api.create_delete.delete_vertex_fragment" Version="0.3.4" CaseType="SelfValidate">
 <Text>glCreateShader(GL_VERTEX_SHADER);</Text>
 <Text>// 1 returned</Text>
 <Text>glCreateShader(GL_FRAGMENT_SHADER);</Text>
 <Text>// 2 returned</Text>
 <Text>glShaderSource(1, 1, 0x09deddd8, 0x00000000);</Text>
 <Text>glCompileShader(1);</Text>
 <Text>glShaderSource(2, 1, 0x09dedddc, 0x00000000);</Text>
 <Text>glCompileShader(2);</Text>
 <Text>glGetError();</Text>
 <Text>// GL_NO_ERROR returned</Text>
 <Text>glCreateProgram();</Text>
 <Text>// 3 returned</Text>
 <Text>glAttachShader(3, 1);</Text>
 <Text>glAttachShader(3, 2);</Text>
 <Text>glGetError();</Text>
 <Text>// GL_NO_ERROR returned</Text>
 <Text>glLinkProgram(3);</Text>
 <Text>glGetError();</Text>
 <Text>// GL_NO_ERROR returned</Text>
 <Text>glDeleteShader(1);</Text>
 <Text>glDeleteShader(2);</Text>
 <Text>glGetError();</Text>
 <Text>// GL_NO_ERROR returned</Text>
 <Text>glGetShaderiv(1, GL_DELETE_STATUS, 0x09dede04);</Text>
 <Text>// params = { 1 }</Text>
 <Text>glGetError();</Text>
 <Text>// GL_NO_ERROR returned</Text>
 <Text>glGetShaderiv(2, GL_DELETE_STATUS, 0x09dede04);</Text>
 <Text>// params = { 1 }</Text>
 <Text>glGetError();</Text>
 <Text>// GL_NO_ERROR returned</Text>
 <Text>glDeleteProgram(3);</Text>
 <Text>glIsShader(1);</Text>
 <Text>// GL_FALSE returned</Text>
 <Text>glIsShader(2);</Text>
 <Text>// GL_FALSE returned</Text>
 <Number Name="TestDuration" Description="Test case duration in microseconds" Tag="Time" Unit="us">32544</Number>
 <Result StatusCode="Pass">Pass</Result>
</TestCaseResult>

#endTestCaseResult


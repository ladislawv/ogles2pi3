#beginTestCaseResult dEQP-GLES2.functional.fbo.render.shared_colorbuffer.tex2d_rgb
<?xml version="1.0" encoding="UTF-8"?>
<TestCaseResult CasePath="dEQP-GLES2.functional.fbo.render.shared_colorbuffer.tex2d_rgb" Version="0.3.4" CaseType="SelfValidate">
 <Text>glClearColor(0.125, 0.25, 0.5, 1);</Text>
 <Text>glClear(GL_DEPTH_BUFFER_BIT|GL_STENCIL_BUFFER_BIT|GL_COLOR_BUFFER_BIT);</Text>
 <Text>glBindTexture(GL_TEXTURE_2D, 1);</Text>
 <Text>glTexImage2D(GL_TEXTURE_2D, 0, GL_RGB, 64, 64, 0, GL_RGB, GL_UNSIGNED_BYTE, 0x99ba20c);</Text>
 <Text>glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_LINEAR);</Text>
 <Text>glBindTexture(GL_TEXTURE_2D, 2);</Text>
 <Text>glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA, 64, 64, 0, GL_RGBA, GL_UNSIGNED_BYTE, 0x99ba20c);</Text>
 <Text>glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_LINEAR);</Text>
 <Text>glViewport(0, 0, 128, 128);</Text>
 <Text>glUseProgram(1);</Text>
 <Text>glGetUniformLocation(1, u_sampler0);</Text>
 <Text>// 0 returned</Text>
 <Text>glUniform1i(0, 0);</Text>
 <Text>glGenFramebuffers(1, 0x0999bf8c);</Text>
 <Text>// framebuffers = { 1 }</Text>
 <Text>glBindFramebuffer(GL_FRAMEBUFFER, 1);</Text>
 <Text>glGenTextures(1, 0x0999bf90);</Text>
 <Text>// textures = { 3 }</Text>

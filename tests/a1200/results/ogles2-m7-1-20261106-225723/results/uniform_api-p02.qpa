  <Text>// 0 returned</Text>
  <Text>// Texture for the sampler uniform u_var[0] will be filled with color (0.46, 0.24, 0.38, 0.94)</Text>
  <Text>glUniform1iv(0, 1, { 0 });</Text>
  <Text>glGetError();</Text>
  <Text>// GL_NO_ERROR returned</Text>
  <Text>glGetUniformLocation(1, u_var[1]);</Text>
  <Text>// 1 returned</Text>
  <Text>// Texture for the sampler uniform u_var[1] will be filled with color (0.87, 0.05, 0.22, 0.48)</Text>
  <Text>glUniform1iv(1, 1, { 1 });</Text>
  <Text>glGetError();</Text>
  <Text>// GL_NO_ERROR returned</Text>
  <Text>glGetUniformLocation(1, u_var[2]);</Text>
  <Text>// 2 returned</Text>
  <Text>// Texture for the sampler uniform u_var[2] will be filled with color (0.30, 0.02, 0.22, 0.26)</Text>
  <Text>glUniform1iv(2, 1, { 2 });</Text>
  <Text>glGetError();</Text>
  <Text>// GL_NO_ERROR returned</Text>
</Section>
 <Section Name="RenderTest" Description="Render test">
  <Text>// Filling texture at unit 0 with color vec4(0.46, 0.24, 0.38, 0.94)</Text>
  <Text>// Filling texture at unit 1 with color vec4(0.87, 0.05, 0.22, 0.48)</Text>
  <Text>// Filling texture at unit 2 with color vec4(0.30, 0.02, 0.22, 0.26)</Text>
  <Text>glViewport(201, 36, 32, 32);</Text>
  <Text>glGetError();</Text>
  <Text>// GL_NO_ERROR returned</Text>
  <Text>glGetAttribLocation(1, a_position);</Text>
  <Text>// 0 returned</Text>
  <Text>glEnableVertexAttribArray(0);</Text>
  <Text>glVertexAttribPointer(0, 4, GL_FLOAT, GL_FALSE, 0, 0x9d9d1ec);</Text>
  <Text>glDrawElements(GL_TRIANGLES, 6, GL_UNSIGNED_SHORT, 0x9d9d1e0);</Text>
  <Text>glGetError();</Text>
  <Text>// GL_NO_ERROR returned</Text>
  <Text>Success: got all-white pixels (all uniforms have correct values)</Text>
</Section>
 <Number Name="TestDuration" Description="Test case duration in microseconds" Tag="Time" Unit="us">57597</Number>
 <Result StatusCode="Pass">Passed</Result>
</TestCaseResult>

#endTestCaseResult


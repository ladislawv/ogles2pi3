  <InfoLog></InfoLog>
  <VertexShader CompileStatus="Fail">
   <ShaderSource>precision mediump float;
attribute highp vec4 dEQP_Position;

varying float var1;
varying float var2;

void main()
{
    var1 = in0;
    var2 = var1 + in0;
    gl_Position = dEQP_Position;

}
</ShaderSource>
   <InfoLog>0:9(9): error: `in0&apos; undeclared
0:10(16): error: `in0&apos; undeclared

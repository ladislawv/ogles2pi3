   <ShaderSource>attribute highp vec4 dEQP_Position;

varying bool var;
void main()
{
    gl_Position = dEQP_Position;

}
</ShaderSource>
   <InfoLog>0:3(1): error: illegal type for a varying variable
</InfoLog>
</VertexShader>

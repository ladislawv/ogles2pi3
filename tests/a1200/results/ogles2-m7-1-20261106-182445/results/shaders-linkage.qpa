{
    gl_FragColor = vec4(1.0);
}
</ShaderSource>
   <InfoLog>0:1(1): error: illegal type for a varying variable
0:1(1): error: fragment shader input cannot have type bool
</InfoLog>
</FragmentShader>
</ShaderProgram>

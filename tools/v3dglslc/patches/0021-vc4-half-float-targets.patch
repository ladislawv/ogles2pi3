+/* ogles2 (patch 0021): val as a half float into half chan (0 low, 1 high)
+ * of dest, regfile A's 16a/16b float pack. */
+static inline void
+qir_PACK_16_F(struct vc4_compile *c, struct qreg dest, struct qreg val, int chan)
+{
+        assert(!dest.pack);
+        dest.pack = QPU_PACK_A_16A + chan;
+        qir_emit_nondef(c, qir_inst(QOP_FMOV, dest, val, c->undef));
+}

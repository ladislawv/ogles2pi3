+/* ogles2 (docs/PI3_PLAN.md §2.1, EXT_color_buffer_half_float, patch 0021):
+ * a half-float target is the tile buffer's 64-bit colour mode (RGBA16F
+ * pixels, stored as such: the RGBA64 texture type), read and written as two
+ * words a pixel, RG then BA, each two halves (VideoCore IV guide, "Color
+ * Read and Write"). The blend is done in floats, unclamped, the colour mask
+ * per channel; the two words go out as the per-sample colour writes do
+ * (TLB_COLOR_MS, which acts as TLB_COLOR_ALL without MSAA). No logic op, no
+ * MSAA. */
+static nir_def *
+vc4_nir_hdr_pipeline(struct vc4_compile *c, nir_builder *b, nir_def *src)
+{
+        nir_def *src_color[4], *out[4];
+        for (unsigned i = 0; i < 4; i++)
+                src_color[i] = nir_channel_or_undef(b, src, i);
+
+        if (blend_depends_on_dst_color(c)) {
+                nir_def *rg = nir_unpack_half_2x16(b, vc4_nir_get_dst_color(b, 0));
+                nir_def *ba = nir_unpack_half_2x16(b, vc4_nir_get_dst_color(b, 1));
+                nir_def *dst_color[4] = {
+                        nir_channel(b, rg, 0), nir_channel(b, rg, 1),
+                        nir_channel(b, ba, 0), nir_channel(b, ba, 1),
+                };
+                vc4_do_blending_f(c, b, out, src_color, dst_color);
+                for (int i = 0; i < 4; i++) {
+                        if (!(c->fs_key->blend.colormask & (1 << i)))
+                                out[i] = dst_color[i];
+                }
+        } else {
+                for (int i = 0; i < 4; i++)
+                        out[i] = src_color[i];
+        }
+
+        return nir_vec2(b, nir_pack_half_2x16_split(b, out[0], out[1]),
+                        nir_pack_half_2x16_split(b, out[2], out[3]));
+}

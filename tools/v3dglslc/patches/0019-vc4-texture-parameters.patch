+static void
+ntq_emit_tex(struct vc4_compile *c, nir_tex_instr *instr)
+{
+        struct qreg lod = { 0 }, compare = { 0 };
+        struct qreg r = { 0 }, s= { 0 }, t = { 0 };
+        bool is_txb = false, is_txl = false;
+        unsigned unit = instr->texture_index;
+
+        if (instr->op == nir_texop_txf) {
+                ntq_emit_txf(c, instr);
+                return;
+        }
+
+        assert(instr->num_srcs > 0);
+        for (unsigned i = 0; i < instr->num_srcs; i++) {
+                switch (instr->src[i].src_type) {
+                case nir_tex_src_coord:
+                        s = ntq_get_src(c, instr->src[i].src, 0);
+                        if (instr->sampler_dim == GLSL_SAMPLER_DIM_1D)
+                                t = qir_uniform_f(c, 0.5);
+                        else
+                                t = ntq_get_src(c, instr->src[i].src, 1);
+                        if (instr->sampler_dim == GLSL_SAMPLER_DIM_CUBE)
+                                r = ntq_get_src(c, instr->src[i].src, 2);
+                        break;
+                case nir_tex_src_bias:
+                        lod = ntq_get_src(c, instr->src[i].src, 0);
+                        is_txb = true;
+                        break;
+                case nir_tex_src_lod:
+                        lod = ntq_get_src(c, instr->src[i].src, 0);
+                        is_txl = true;
+                        break;
+                case nir_tex_src_comparator:
+                        compare = ntq_get_src(c, instr->src[i].src, 0);
+                        break;
+                default:
+                        UNREACHABLE("unknown texture source");
+                }
+        }
+
+        if (c->stage != QSTAGE_FRAG && !is_txl) {
+                /* From the GLSL 1.20 spec:
+                 *
+                 *     "If it is mip-mapped and running on the vertex shader,
+                 *      then the base texture is used."
+                 */
+                is_txl = true;
+                lod = qir_uniform_ui(c, 0);
+        }
+
+        /* ogles2 (docs/PI3_PLAN.md §2.1): EXT_texture_lod_bias,
+         * SGIS_texture_lod's min and max LOD and
+         * EXT_texture_filter_anisotropic, which VC4's TMU lacks (it has a
+         * bias input and an explicit LOD, BSLOD in P2, and no clamp). The
+         * texture's bias is added to the shader's (or to an explicit LOD);
+         * with a clamp or anisotropy the LOD is computed here from the
+         * coordinates' derivatives in texels (the texture's size as
+         * uniforms: GL's rho, the larger of the two axes' lengths), the
+         * lookup made with it explicitly, and clamped to the texture's
+         * range. Anisotropy takes 2^aniso lookups spread along the major
+         * axis (its length in the footprint, centred), the LOD from the
+         * major axis divided by their number but not below the minor
+         * axis's, and averages them. Not for cube maps (the library keys
+         * only the bias for them) nor when one level is forced.
+         */
+        bool forced = c->key->tex[unit].force_first_level;
+        bool not_cube = instr->sampler_dim != GLSL_SAMPLER_DIM_CUBE;
+        unsigned aniso = c->stage == QSTAGE_FRAG && not_cube && !forced &&
+                !is_txl ? c->key->tex[unit].aniso : 0;
+        bool lod_clamp = c->key->tex[unit].lod_clamp && not_cube && !forced;
+        struct qreg major_s = { 0 }, major_t = { 0 };
+
+        if ((lod_clamp || aniso) && !is_txl) {
+                struct qreg w = qir_uniform(c, QUNIFORM_TEXTURE_WIDTH, unit);
+                struct qreg h = qir_uniform(c, QUNIFORM_TEXTURE_HEIGHT, unit);
+                struct qreg dsdx = ntq_fddx(c, s), dtdx = ntq_fddx(c, t);
+                struct qreg dsdy = ntq_fddy(c, s), dtdy = ntq_fddy(c, t);
+                struct qreg ux = qir_FMUL(c, dsdx, w), vx = qir_FMUL(c, dtdx, h);
+                struct qreg uy = qir_FMUL(c, dsdy, w), vy = qir_FMUL(c, dtdy, h);
+                struct qreg px2 = qir_FADD(c, qir_FMUL(c, ux, ux),
+                                           qir_FMUL(c, vx, vx));
+                struct qreg py2 = qir_FADD(c, qir_FMUL(c, uy, uy),
+                                           qir_FMUL(c, vy, vy));
+                struct qreg rho2 = qir_FMAX(c, px2, py2);
+
+                if (aniso) {
+                        /* the major axis in coordinates, and rho2 the
+                         * larger of (major / n)^2 and minor^2 */
+                        struct qreg minor2 = qir_FMIN(c, px2, py2);
+                        float inv_n2 = 1.0f / (float)((1 << aniso) * (1 << aniso));
+
+                        qir_SF(c, qir_FSUB(c, px2, py2));
+                        major_s = qir_MOV(c, qir_SEL(c, QPU_COND_NC,
+                                                     dsdx, dsdy));
+                        major_t = qir_MOV(c, qir_SEL(c, QPU_COND_NC,
+                                                     dtdx, dtdy));
+                        rho2 = qir_FMAX(c, qir_FMUL(c, rho2,
+                                                    qir_uniform_f(c, inv_n2)),
+                                        minor2);
+                }
+
+                /* log2(rho) = log2(rho^2) / 2; the bias of the third
+                 * argument of texture2D added */
+                struct qreg lambda = qir_FMUL(c, qir_LOG2(c, rho2),
+                                              qir_uniform_f(c, 0.5f));
+                lod = is_txb ? qir_FADD(c, lambda, lod) : lambda;
+                is_txl = true;
+                is_txb = false;
+        }
+
+        if (!forced && c->key->tex[unit].lod_bias) {
+                struct qreg bias = qir_uniform(c, QUNIFORM_TEXTURE_LOD_BIAS,
+                                               unit);
+                if (is_txl || is_txb) {
+                        lod = qir_FADD(c, lod, bias);
+                } else {
+                        lod = bias;
+                        is_txb = true;
+                }
+        }
+
+        if (lod_clamp && is_txl) {
+                lod = qir_FMIN(c, qir_FMAX(c, lod,
+                                           qir_uniform(c, QUNIFORM_TEXTURE_MIN_LOD, unit)),
+                               qir_uniform(c, QUNIFORM_TEXTURE_MAX_LOD, unit));
+        }
+
+        if (forced) {
+                lod = qir_uniform(c, QUNIFORM_TEXTURE_FIRST_LEVEL, unit);
+                is_txl = true;
+                is_txb = false;
+        }
+
+        struct qreg out[4];
+
+        if (aniso) {
+                unsigned n = 1 << aniso;
+                struct qreg sum[4];
+
+                for (unsigned k = 0; k < n; k++) {
+                        struct qreg o[4];
+                        struct qreg f = qir_uniform_f(c, ((float)k + 0.5f) /
+                                                      (float)n - 0.5f);
+                        ntq_tex_lookup(c, instr,
+                                       qir_FADD(c, s, qir_FMUL(c, major_s, f)),
+                                       qir_FADD(c, t, qir_FMUL(c, major_t, f)),
+                                       r, lod, is_txl, is_txb, compare, NULL, o);
+                        for (int i = 0; i < 4; i++)
+                                sum[i] = k ? qir_FADD(c, sum[i], o[i]) : o[i];
+                }
+                for (int i = 0; i < 4; i++) {
+                        out[i] = qir_FMUL(c, sum[i],
+                                          qir_uniform_f(c, 1.0f / (float)n));
+                        ntq_store_def(c, &instr->def, i, out[i]);
+                }
         } else {
-                for (int i = 0; i < 4; i++)
-                        ntq_store_def(c, &instr->def, i,
-                                      qir_UNPACK_8_F(c, tex, i));
+                ntq_tex_lookup(c, instr, s, t, r, lod, is_txl, is_txb,
+                               compare, &instr->def, out);
         }
 }
 
